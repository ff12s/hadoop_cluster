# Версии компонентов
HADOOP_VERSION=3.3.6
HIVE_VERSION=3.1.3
SPARK_VERSION=3.5.2
SCALA_VERSION=2.13.8
PYTHON_VERSION=3.12.7
KYUUBI_VERSION=1.10.2
TEZ_VERSION=0.10.2
JUPYTER_VERSION=4.3.0
AIRFLOW_VERSION=2.6.3

# Cloud-вариант образа Airflow: собирается из airflow/requirements_cloud_slim.txt.
# Переключение рантайма: AIRFLOW_IMAGE=hadoop-cluster-airflow:2.10.2 docker compose up -d airflow
AIRFLOW_CLOUD_VERSION=2.10.2

# Airflow. Значения по умолчанию заданы в docker-compose.yml, здесь перечислены
# точки переопределения: раскомментируйте нужную строку и задайте своё значение.
# Пароль роли метаданных подставляется в URI подключения как есть, поэтому
# символы @ : / # ? в нём использовать нельзя.
#AIRFLOW_DB_USER=airflow
#AIRFLOW_DB_PASSWORD=airflow
#AIRFLOW_DB_NAME=airflow
# Учётка UI создаётся один раз, при первичной инициализации метаданных.
#AIRFLOW_ADMIN_USER=admin
#AIRFLOW_ADMIN_PASSWORD=admin
# Пустой ключ = секреты Connection'ов и Variable лежат в базе открытым текстом.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#AIRFLOW_FERNET_KEY=
# AIRFLOW_IMAGE выбирает, какой из двух собранных образов поднимается: base
# (hadoop-cluster-airflow:latest, requirements_slim.txt) или cloud
# (hadoop-cluster-airflow:2.10.2, requirements_cloud_slim.txt).
#AIRFLOW_IMAGE=hadoop-cluster-airflow:latest
# Нативный провайдер openlineage есть только в cloud-образе; в base-образе
# переменная безвредна. По умолчанию выключен, чтобы не дублировать события
# лайниджа со Spark-листенером cluster policy.
#AIRFLOW_OPENLINEAGE_PROVIDER_DISABLED=true

# OpenLineage / Marquez
OPENLINEAGE_VERSION=1.46.0
# Конфиг лайниджа живёт в Airflow Variable openlineage_config (Admin -> Variables),
# а не в .env. OPENLINEAGE_CONFIG_RESEED=true пересевает Variable дефолтами при старте —
# устаревший рычаг, оставлен на случай миграции.
#OPENLINEAGE_CONFIG_RESEED=false
MARQUEZ_VERSION=0.47.0

# Настройки Java
JAVA_VERSION=8

# Docker Hub registry для образов кластера
REGISTRY=fufa242
